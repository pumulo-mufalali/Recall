rules_version = '2';

// Each learner reads and writes only their own data, under users/{uid}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // The cross-deck card listener queries the "cards" collection group by owner.
    match /{path=**}/cards/{cardId} {
      allow read: if request.auth != null && resource.data.owner == request.auth.uid;
    }
  }
}
