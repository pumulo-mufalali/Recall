# Copy to .env.local (never committed) and fill in from the Firebase console:
# Project settings > Your apps > Web app > SDK setup and configuration > Config (as one line of JSON).
VITE_FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
# App Check: Security > App Check > reCAPTCHA Enterprise site key (production).
VITE_RECAPTCHA_ENTERPRISE_KEY=
# Optional: a fixed App Check debug token for local development (else one is printed in the console).
VITE_APPCHECK_DEBUG_TOKEN=
